# Copy to .env (loaded by the Makefile). Defaults target the local stack in compose.yaml.

# --- Kafka, as seen from this machine (sample producer, topic creation) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Landing: Flink job -> Iceberg (target-agnostic) ---
FLINK_SQL_GATEWAY_URL=http://localhost:8083
FLINK_REST_URL=http://localhost:8081
FLINK_KAFKA_BOOTSTRAP_SERVERS=kafka:19092
FLINK_CHECKPOINT_INTERVAL=10s
# Extra Kafka source options as JSON, e.g. {"properties.security.protocol": "SASL_SSL", "properties.sasl.mechanism": "PLAIN"}
# FLINK_KAFKA_PROPERTIES=
ICEBERG_CATALOG_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=s3://warehouse/
# Extra Iceberg catalog properties as JSON (default: local S3-compatible storage), e.g. for a cloud catalog:
# {"credential": "<client-id>:<secret>", "oauth2-server-uri": "...", "header.X-Iceberg-Access-Delegation": "vended-credentials"}
# ICEBERG_CATALOG_PROPERTIES=
# Local stack only: create the bucket in the S3-compatible storage.
LOCAL_S3_ENDPOINT=http://localhost:9000
# Use a Maven mirror for the Flink jars if needed.
# MAVEN_REPO=https://repo1.maven.org/maven2

DBT_TARGET=dev

# --- AI ops (config/ops.yml, docs/ai_ops.md) ---
# Any OpenAI-compatible gateway (LiteLLM, Portkey, Kong, OpenRouter, Azure OpenAI, vLLM, ...).
# Leave empty to let the built-in rules decide.
LLM_GATEWAY_URL=
LLM_API_KEY=
LLM_MODEL=
# Slack-compatible incoming webhook.
ALERT_WEBHOOK_URL=
# Overrides `mode` in config/ops.yml: off | advise | act
# AI_OPS_MODE=
