
# --- Target: Snowflake (reads the Iceberg landing tables created by snowflake/landing_tables.sql) ---
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_dbt.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE={{ cookiecutter.project_slug | upper }}
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_SCHEMA=DEV
LANDING_DATABASE={{ cookiecutter.project_slug | upper }}
LANDING_SCHEMA={{ cookiecutter.landing_namespace | upper }}
