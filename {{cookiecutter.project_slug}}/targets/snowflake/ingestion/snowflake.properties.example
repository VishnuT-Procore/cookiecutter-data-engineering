# Mount on every Kafka Connect worker at /opt/kafka/secrets/snowflake.properties and enable the
# file config provider in the worker config:
#   config.providers=file
#   config.providers.file.class=org.apache.kafka.common.config.provider.FileConfigProvider
url=<account_identifier>.snowflakecomputing.com:443
user=KAFKA_CONNECTOR_USER
role=KAFKA_CONNECTOR
database={{ cookiecutter.project_slug | upper }}
private_key=<PKCS8 private key body, single line, without header/footer>
private_key_passphrase=
