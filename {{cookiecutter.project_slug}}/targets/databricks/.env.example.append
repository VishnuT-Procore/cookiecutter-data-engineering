
# --- Target: Databricks ---
# Landing in Unity Catalog: point the Flink job at the Unity Catalog Iceberg REST endpoint
# (overrides the local defaults above; see docs/target.md).
# ICEBERG_CATALOG_URI=https://<workspace-host>/api/2.1/unity-catalog/iceberg-rest
# ICEBERG_WAREHOUSE=<uc_catalog>
# ICEBERG_CATALOG_PROPERTIES={"token": "<token>", "header.X-Iceberg-Access-Delegation": "vended-credentials"}
DATABRICKS_HOST=<workspace-host>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<token>
DATABRICKS_CATALOG=<uc_catalog>
DATABRICKS_SCHEMA=dev
LANDING_DATABASE=<uc_catalog>
LANDING_SCHEMA={{ cookiecutter.landing_namespace }}
