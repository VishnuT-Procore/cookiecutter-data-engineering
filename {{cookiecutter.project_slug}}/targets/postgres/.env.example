# Copy to .env (loaded by the Makefile). Defaults match compose.override.yaml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID={{ cookiecutter.project_slug }}-raw-loader
# Any librdkafka setting: KAFKA_CONF_<KEY>, dots as underscores, e.g.
# KAFKA_CONF_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_CONF_SASL_MECHANISM=PLAIN

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dbt
POSTGRES_PASSWORD=dbt
POSTGRES_DB=warehouse
POSTGRES_SCHEMA=dev
DBT_TARGET=dev
