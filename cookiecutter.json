{
  "project_name": "Orders Medallion",
  "project_slug": "{{ cookiecutter.project_name.lower().strip().replace(' ', '_').replace('-', '_') }}",
  "author_name": "Data Engineering",
  "target": ["postgres", "snowflake", "databricks"],
  "payload_format": ["debezium", "json"],
  "topic_prefix": "app.public",
  "raw_schema": "raw",
  "__prompts__": {
    "project_name": "Project name",
    "project_slug": "Project slug (lowercase, underscores)",
    "target": {
      "__prompt__": "Target platform",
      "postgres": "Postgres (Python consumer + dbt-postgres)",
      "snowflake": "Snowflake (Snowflake Kafka Connector + dbt-snowflake)",
      "databricks": "Databricks (Spark Structured Streaming + Delta Lake)"
    },
    "payload_format": {
      "__prompt__": "Kafka message format",
      "debezium": "Debezium CDC envelope (before/after/op/ts_ms)",
      "json": "Plain JSON row per message, tombstone (null value) = delete"
    },
    "topic_prefix": "Kafka topic prefix for the example entities",
    "raw_schema": "Schema/table namespace where raw Kafka records land"
  },
  "_copy_without_render": [
    "scripts/*",
    "targets/*/scripts/*",
    "targets/*/tests/*",
    "targets/*/ingestion/*.py",
    "targets/*/dbt/macros/*",
    "targets/*/dbt/models/*",
    "targets/*/src/*",
    "targets/*/gold/*",
    "targets/*/.github/*"
  ]
}
